{
  "name": "kn-studio",
  "productName": "KN Studio",
  "version": "0.9.1",
  "description": "KN Studio · KN-Detail และ Bar Cut สำหรับงานเหล็กเสริม",
  "author": "KTY Construction",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.kty.knstudio",
    "productName": "KN Studio",
    "files": ["main.js", "preload.js", "icon.png", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "shortcutName": "KN Studio", "artifactName": "KN-Studio-Setup-${version}.exe" },
    "portable": { "artifactName": "KN-Studio-Portable-${version}.exe" }
  }
}
